# Modelo de configuracao. NAO coloque segredos neste arquivo.
# Copie para .env e preencha (o scripts/iniciar.sh faz isso sozinho na 1a vez).
# Para carregar manualmente: source .env

# --- Acesso ao painel -------------------------------------------------------
# Chave que voce digita na tela de entrada do painel. Invente uma forte
# (ex.: openssl rand -hex 16).
export ADMIN_KEY="troque-por-uma-chave-forte"

# --- E-mail -----------------------------------------------------------------
# console: nao envia nada; o link de assinatura aparece no terminal (desenvolvimento).
# resend:  envia e-mail de verdade (precisa de RESEND_API_KEY, veja o README).
export EMAIL_PROVIDER=console
export RESEND_API_KEY=""
export EMAIL_FROM="Angel Signature <onboarding@resend.dev>"

# --- Certificado do selo digital dos PDFs (PAdES) ---------------------------
# Gerado por scripts/gerar-certificado-teste.sh. A senha e a que voce escolher.
export SIGNING_CERT_PATH="certs/servico.p12"
export SIGNING_CERT_PASSWORD=""

# --- TLS / HTTPS ------------------------------------------------------------
# Certificado do servidor, usado no HTTPS do painel e no TLS do canal TCP.
# Gerado por scripts/gerar-certificado-https.sh.
export HTTPS_KEYSTORE_PATH="certs/https.p12"
export HTTPS_KEYSTORE_PASSWORD=""

# AC em que o cliente TCP (CLI e gateway) confia para validar o servidor.
export SICA_TLS_CA="certs/ac-teste.crt"

# --- Endereco publico -------------------------------------------------------
# Base dos links enviados por e-mail. Se for abrir o link em outro aparelho,
# troque localhost pelo IP do computador (e gere o certificado com esse IP).
export BASE_URL="https://localhost:8080"

# --- Opcional ---------------------------------------------------------------
# Carimbo de tempo (RFC 3161). Use "none" para trabalhar sem internet.
# export TSA_URL="https://freetsa.org/tsr"
