<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.edu.pucgo</groupId>
    <artifactId>angel-signature</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Angel Signature</name>
    <description>
        Angel Signature (Anjos Tecnologia) - servico de assinatura eletronica de
        documentos PDF com selo PAdES e carimbo de tempo, construido sobre o
        SiCA (Sistema de Compartilhamento de Arquivos via sockets TCP).
        Projeto Integrador - PUC Goias.
    </description>

    <properties>
        <!-- Compila para Java 17 (mesma versao do repositorio de referencia). -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        O nucleo do SiCA (TCP, cliente CLI, gateway) usa somente a biblioteca
        padrao do JDK. As dependencias abaixo servem ao modulo de assinatura
        eletronica (sica.assinatura), conforme docs/PLANO-ASSINATURA.md.
        Versoes fixadas (sem intervalos).
    -->
    <dependencies>
        <!-- Manipulacao de PDF (imagem da assinatura, pagina de auditoria). -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.8</version>
        </dependency>

        <!-- Assinatura CMS/PAdES, carimbo de tempo (RFC 3161) e validacao. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.87</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>1.87</version>
        </dependency>

        <!-- Banco local (arquivo unico). -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.54.1.0</version>
        </dependency>

        <!-- Testes. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Nome do JAR gerado em target/. -->
        <finalName>angel-signature-${project.version}</finalName>

        <plugins>
            <!-- Compilacao para Java 17. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- Executa os testes JUnit 5 em "mvn package". -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.6.1</version>
            </plugin>

            <!--
                Permite executar cada componente com "mvn exec:java", sem precisar
                montar o classpath na mao. A classe principal e escolhida pela
                propriedade -Dexec.mainClass=... (veja o README).
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
        </plugins>
    </build>
</project>
